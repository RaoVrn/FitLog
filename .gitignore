# ─── Node / package managers ─────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# ─── Next.js build output ────────────────────────────────────────────────────
web/.next/
web/out/
web/dist/
web/build/

# ─── Environment variables (NEVER commit secrets) ────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# ─── Firebase ────────────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── IDEs & editors ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig
*.bak
*.tmp

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Linting & formatting cache ──────────────────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ─── PWA / service worker ────────────────────────────────────────────────────
web/public/sw.js
web/public/workbox-*.js
web/public/worker-*.js

# ─── Misc ────────────────────────────────────────────────────────────────────
*.pem
*.tgz
*.zip
.vercel
.turbo
.cache/
