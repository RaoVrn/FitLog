# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── IDEs & editors ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig
*.bak
*.tmp

# ─── Node / package managers ─────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# ─── Next.js build output (web app) ─────────────────────────────────────────
web/.next/
web/out/
web/build/
web/dist/
web/.next/analyze/
web/.next/dev/lock

# ─── Testing output ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
web/coverage/
web/.nyc_output/
web/playwright-report/
web/test-results/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Linting/formatting cache ────────────────────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache

# ─── Environment variables (NEVER commit secrets) ───────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
!.env.example
!.env*.example

# ─── Firebase local artifacts ────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ─── Deployment / platform caches ────────────────────────────────────────────
.vercel
.netlify
.turbo
.cache/
.parcel-cache/
.swc/

# ─── Generated worker assets (if PWA is added) ──────────────────────────────
web/public/sw.js
web/public/workbox-*.js
web/public/worker-*.js

# ─── Storybook / analyzer ────────────────────────────────────────────────────
storybook-static/
web/storybook-static/

# ─── Certificates / keys ─────────────────────────────────────────────────────
*.pem
*.key
*.cert
localhost.pem
localhost-key.pem

# ─── Archives / bundles ──────────────────────────────────────────────────────
*.tgz
*.zip

# ─── Sentry ──────────────────────────────────────────────────────────────────
.sentryclirc
